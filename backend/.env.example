DATABASE_URL=sqlite:///./estoque_virtual.db
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=xml,pdf
MAX_FILE_SIZE=10485760
DEBUG=True

# ===== INTEGRACAO OLIST - API SIMPLES (Legado / opcional) =====
OLIST_API_TOKEN_SIMPLE=seu_token_api_2.0_aqui

# ===== INTEGRACAO OLIST - OAUTH2 (API v3) =====
# Crie um Aplicativo API no ERP da Olist e cole as credenciais aqui.
# Veja o passo a passo em SETUP_OLIST_APP.md
OLIST_CLIENT_ID=seu_client_id_aqui
OLIST_CLIENT_SECRET=seu_client_secret_aqui
OLIST_REDIRECT_URI=http://localhost:8000/api/olist/callback

# ===== INTEGRACAO MERCADO LIVRE =====
MERCADO_LIVRE_API_KEY=sua_chave_mercado_livre_aqui
